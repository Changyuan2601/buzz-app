{
  "id": "buzz.claude-code",
  "name": "Claude",
  "apiVersion": 1,
  "description": "Run local Claude coding agents in Buzz.",
  "discovery": {
    "category": "agents",
    "tags": ["Essentials", "code", "coding-agents"]
  },
  "host": {
    "networkOrigins": ["https://downloads.claude.ai"],
    "processes": [
      {
        "id": "claude-sh",
        "program": "bash",
        "args": ["-c"]
      },
      {
        "id": "platform",
        "program": "uname",
        "args": ["-sm"]
      },
      {
        "id": "read",
        "program": "base64",
        "args": ["-i"]
      },
      { "id": "workspace", "program": "pwd" },
      {
        "id": "find",
        "program": "grep",
        "args": ["-rlF", "--include=*.jsonl", "-e"]
      },
      {
        "id": "claude-ps",
        "program": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-EncodedCommand"
        ]
      },
      { "id": "claude-exe", "program": "current/claude.exe", "data": true },
      { "id": "claude-next", "program": "next/claude.exe", "data": true }
    ]
  }
}
