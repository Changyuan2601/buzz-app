{
  "id": "buzz.github",
  "name": "GitHub",
  "apiVersion": 1,
  "description": "View GitHub repositories, pull requests, issues, and commits.",
  "discovery": { "category": "developer-tools-and-integrations" },
  "host": {
    "commands": [
      {
        "id": "pull",
        "program": "gh",
        "args": ["api", "graphql", "--input", "-"],
        "maxInputBytes": 4096,
        "maxOutputBytes": 1048576
      }
    ]
  }
}
